TRANSPORT=http
HOST=127.0.0.1
PORT=3100
MCP_PATH=/mcp
ALLOWED_HOSTS=chainrpc-mcp.mitander.io,localhost,127.0.0.1
CORS_ORIGINS=https://chainrpc-mcp.mitander.io
HTTP_BODY_LIMIT=1mb
MAX_MCP_SESSIONS=500

EVM_RPC_URL=https://ethereum-rpc.publicnode.com
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com
RPC_TIMEOUT_MS=12000
RPC_RETRIES=2
RPC_MAX_RESPONSE_BYTES=10000000
RPC_MAX_CONCURRENCY=20

ALLOW_EVM_BROADCAST=false
ALLOW_BITCOIN_BROADCAST=false
