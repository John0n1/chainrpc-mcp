# PublicNode is used when these are omitted.
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com

# Optional basic authentication for self-hosted JSON-RPC nodes.
# EVM_RPC_USERNAME=
# EVM_RPC_PASSWORD=
# BITCOIN_RPC_USERNAME=
# BITCOIN_RPC_PASSWORD=

# RPC resilience and resource bounds.
RPC_TIMEOUT_MS=12000
RPC_RETRIES=1
RPC_MAX_RESPONSE_BYTES=10000000
RPC_MAX_CONCURRENCY=20
MAX_MCP_SESSIONS=1000

# Transaction broadcasts require both an opt-in here and explicit tool-call confirmation.
ALLOW_EVM_BROADCAST=false
ALLOW_BITCOIN_BROADCAST=false

# The package defaults to stdio. `npm start` explicitly selects HTTP.
TRANSPORT=stdio
HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp
HTTP_BODY_LIMIT=1mb

# Required for HTTP binding outside loopback. Comma-separated hostnames, optionally with ports.
# ALLOWED_HOSTS=mcp.example.com,localhost
# CORS_ORIGINS=https://app.example.com
# MCP_AUTH_TOKEN=replace-with-a-long-random-token
